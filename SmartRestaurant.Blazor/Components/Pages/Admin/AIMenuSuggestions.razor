@inject IChatbotService ChatbotService
@using SmartRestaurant.Application.Interfaces.Abstractions.AI
@using SmartRestaurant.Domain.Models

<div class="card mb-4">
    <div class="card-body">
        <h5>🤖 AI Menu Suggestions</h5>
        <p class="text-muted">Get intelligent recommendations based on your current menu.</p>
        <button class="btn btn-info" @onclick="GenerateSuggestions" disabled="@isGenerating">
            @(isGenerating ? "⏳ Generating..." : "✨ Generate Suggestions")
        </button>

        @if (!string.IsNullOrWhiteSpace(Suggestions))
        {
            <div class="alert alert-light mt-3">
                <pre class="mb-0">@Suggestions</pre>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<MenuItem> MenuItems { get; set; } = new();
    private bool isGenerating;
    private string? Suggestions;

    private async Task GenerateSuggestions()
    {
        isGenerating = true;
        var menuNames = string.Join(", ", MenuItems.Select(m => m.Name));
        Suggestions = await ChatbotService.Ask($"Given the menu items: {menuNames}, suggest 3 new items.");
        isGenerating = false;
    }
}