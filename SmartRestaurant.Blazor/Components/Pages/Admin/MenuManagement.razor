@using SmartRestaurant.Application.Interfaces
@using SmartRestaurant.Domain.Models
@inject IMenuService MenuService
@using Microsoft.AspNetCore.Components.Forms

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">📋 Menu Management</h5>
            <button class="btn btn-success" @onclick="OpenAddModal">➕ Add Item</button>
        </div>

        @if (!MenuItems.Any())
        {
            <p class="text-muted">No menu items yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th style="width:150px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in MenuItems)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" style="max-height:50px;" class="me-2" />
                                    }
                                    <strong>@item.Name</strong>
                                </td>
                                <td>@item.Description</td>
                                <td>$@item.Price.ToString("F2")</td>
                                <td>
                                    <button class="btn btn-primary btn-sm me-2" @onclick="() => OpenEditModal(item)">Edit</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => OpenDeleteModal(item.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* Add/Edit Modal *@
    @if (ShowMenuModal)
    {
        <div class="modal fade show d-block" style="background:rgba(0,0,0,.6)">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@((IsEditMode ? "✏️ Edit Menu Item" : "➕ Add Menu Item"))</h5>
                        <button class="btn-close" @onclick="CloseMenuModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control" @bind="ModalItem.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="3" @bind="ModalItem.Description"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input type="number" class="form-control" step="0.01" @bind="ModalItem.Price" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Image</label>
                            <InputFile OnChange="OnImageSelected" />
                            @if (!string.IsNullOrEmpty(ModalItem.Image))
                            {
                                <img src="@ModalItem.Image" class="img-fluid mt-2" style="max-height:150px;" />
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseMenuModal">Cancel</button>
                        <button class="btn btn-success" @onclick="SaveMenuItem">@((IsEditMode ? "Update" : "Add"))</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Delete Modal *@
    @if (ShowDeleteModal)
    {
        <div class="modal fade show d-block" style="background:rgba(0,0,0,.6)">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">⚠️ Confirm Delete</h5>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this menu item?</p>
                        <p class="text-danger mb-0">This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                        <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<MenuItem> MenuItems { get; set; } = new();
    [Parameter] public EventCallback OnChange { get; set; }

    private bool ShowMenuModal;
    private bool ShowDeleteModal;
    private bool IsEditMode;
    private Guid DeleteItemId;
    private MenuItem ModalItem = new();

    private void OpenAddModal() { IsEditMode = false; ModalItem = new(); ShowMenuModal = true; }
    private void OpenEditModal(MenuItem item) { IsEditMode = true; ModalItem = new MenuItem { Id = item.Id, Name = item.Name, Description = item.Description, Price = item.Price, Image = item.Image, IsAvailable = true }; ShowMenuModal = true; }
    private void CloseMenuModal() => ShowMenuModal = false;

    private void OpenDeleteModal(Guid id) { DeleteItemId = id; ShowDeleteModal = true; }
    private void CloseDeleteModal() => ShowDeleteModal = false;

    private async Task SaveMenuItem()
    {
        ModalItem.IsAvailable = true;
        if (IsEditMode) await MenuService.UpdateAsync(ModalItem);
        else await MenuService.AddAsync(ModalItem);

        await OnChange.InvokeAsync();
        CloseMenuModal();
    }

    private async Task ConfirmDelete()
    {
        await MenuService.DeleteAsync(DeleteItemId);
        await OnChange.InvokeAsync();
        CloseDeleteModal();
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var filename = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
        var path = Path.Combine("wwwroot/images", filename);

        if (!Directory.Exists("wwwroot/images"))
            Directory.CreateDirectory("wwwroot/images");

        using var fs = new FileStream(path, FileMode.Create);
        await file.OpenReadStream().CopyToAsync(fs);

        ModalItem.Image = $"/images/{filename}";
    }
}